# Local full-stack example. Replace every marked value before production use.
POSTGRES_PASSWORD=replace-with-a-random-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes

# Browser-visible and backend URLs.
FRONTEND_URL=http://localhost:3003
BACKEND_URL=http://localhost:8003
NEXT_PUBLIC_API_URL=http://localhost:8003
NEXT_PUBLIC_APP_URL=http://localhost:3003
NEXT_PUBLIC_APP_NAME=AI Championship
NEXT_PUBLIC_COMPETITION_SLUG=demo-championship
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Local development only. Set false and configure Google OAuth in production.
ALLOW_MOCK_AUTH=true
ALLOW_INSECURE_HTTP=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8003/auth/callback

# Required when endpoint submissions include an API key. Generate with:
# python -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
SUBMISSION_SECRET_KEY=

# Optional integrations.
LOOPS_API_KEY=
LOOPS_TRANSACTIONAL_ID=
LOOPS_INVITE_TRANSACTIONAL_ID=
LOOPS_MEMBER_JOINED_TRANSACTIONAL_ID=
NEXT_PUBLIC_SLACK_INVITE_URL=
CODE_SUBMISSIONS_BUCKET=code-submissions
PARTICIPANT_DATA_BUCKET=participant-data
